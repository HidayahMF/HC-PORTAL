APP_PORT=3004
FRONTEND_URL=http://<SERVER-IP>:3004
PORT=3000
NODE_ENV=production
DB_SERVER=<DATABASE-SERVER>
DB_PORT=1433
DB_DATABASE=<DATABASE-NAME>
DB_USER=<DATABASE-USER>
DB_PASSWORD=<DATABASE-PASSWORD>
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
JWT_SECRET=<LONG-RANDOM-SECRET-MINIMUM-32-CHARACTERS>
JWT_EXPIRES_IN=86400
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=86400000
AUTH_ALLOWED_NIPS=3490
AUTH_ADMIN_ROLE=ADMIN
AUTH_ACCESS_TABLE=dbo.EmployeeAccess
# Allowed application roles are ADMIN and HR. HR may manage existing access but cannot grant new access.
HRIS_EMPLOYEE_TABLE=dbo.hris_Employee
HRIS_EMPLOYEE_NIP_COL=NIP
HRIS_EMPLOYEE_NAME_COL=Name
HRIS_EMPLOYEE_BIRTHDATE_COL=BirthDate
HRIS_EMPLOYEE_ACTIVE_COL=is_Active
HRIS_ACTIVE_VALUES=1,Y,true,TRUE
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
LETTER_SEQUENCE_LEGACY_YEAR=2026
LETTER_SEQUENCE_LEGACY_START=692
