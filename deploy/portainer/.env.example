# Copy to the Portainer stack environment editor. Never commit the filled file.
NODE_ENV=production
TZ=Asia/Jakarta
APP_PORT=3011

# Existing SQL Server used by Nomor Surat, Kontrak, and WAG SQL runtime.
DB_SERVER=<existing-sql-server-host>
DB_PORT=1433
DB_DATABASE=BMC
DB_USER=<existing-sql-user>
DB_PASSWORD=<existing-sql-password>
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_TRUST_SERVER_CERT=true
DB_CONNECTION_TIMEOUT=15000
DB_REQUEST_TIMEOUT=30000

# Module authentication. Use a new strong secret only if it is compatible with
# the sessions/tokens that must remain valid during cutover.
JWT_SECRET=<at-least-32-character-secret>
JWT_EXPIRES_IN=86400
COOKIE_MAX_AGE_MS=86400000
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
FRONTEND_URL=https://hc.bmc.co.id
ALLOWED_NIPS=<comma-separated-nips>
ALLOWED_ADMIN_NIPS=<comma-separated-admin-nips>
ALLOWED_VIEWER_NIPS=
AUTH_ALLOWED_NIPS=<nomor-surat-nips>
AUTH_ADMIN_ROLE=ADMIN
AUTH_ACCESS_TABLE=dbo.EmployeeAccess
CONTRACT_AUTH_ACCESS_TABLE=dbo.ContractEmployeeAccess

# HRIS/schema identifiers. Confirm these against the existing database owner.
HRIS_EMPLOYEE_TABLE=dbo.hris_Employee
HRIS_EMPLOYEE_NIP_COL=NIP
HRIS_EMPLOYEE_NAME_COL=Name
HRIS_EMPLOYEE_BIRTHDATE_COL=BirthDate
HRIS_EMPLOYEE_ACTIVE_COL=is_Active
HRIS_EMPLOYEE_DEPARTMENT_ID_COL=DepartID
MASCOSTCENTER_TABLE=dbo.MASCOSTCENTER
MASCOSTCENTER_ID_COL=DepartID
MASCOSTCENTER_NAME_COL=NamaDepartemen
HRIS_ACTIVE_VALUES=1,Y,true,TRUE
LETTER_SEQUENCE_LEGACY_YEAR=2026
LETTER_SEQUENCE_LEGACY_START=692
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Existing WAG MySQL and WhatsApp gateway. Do not point staging at production
# queue/database while the old worker is still active.
MYSQL_HOST=<existing-mysql-host>
MYSQL_PORT=3306
MYSQL_USER=<existing-mysql-user>
MYSQL_PASSWORD=<existing-mysql-password>
MYSQL_DATABASE=pw2
MYSQL_CONNECT_TIMEOUT=10000
MYSQL_POOL_LIMIT=10
WA_API=<existing-whatsapp-send-endpoint>
WA_HEALTH_URL=
WAGW_API=<existing-media-gateway-endpoint-or-empty>
WAGW_FILE_DIR=/mnt/wagw/file
WAGW_SMB_MOUNT=/mnt/wagw
WAGW_SMB_HOST=<smb-host-if-used>
WAG_BACKGROUND_ENABLED=false
LOG_LEVEL=info

# Browser origin. Apache terminates TLS and proxies to 127.0.0.1:3011.
CORS_ORIGIN=https://hc.bmc.co.id

# Keep the new volume separate until upload migration is explicitly verified.
WAG_UPLOAD_VOLUME=hc_portal_wag_uploads
