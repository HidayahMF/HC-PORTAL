FROM node:20 AS build

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

ENV VITE_API_BASE_URL=/wag/api
RUN npm run build

ENV TZ=Asia/Jakarta

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
# Reverse proxy /api → backend + SPA fallback (lihat nginx.conf).
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
