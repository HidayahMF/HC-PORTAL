# ===== FRONTEND ENVIRONMENT TEMPLATE =====
# Salin file ini menjadi .env dan isi nilai riil. JANGAN commit nilai asli.

# URL backend API (WAJIB disetel untuk production build).
# Di development boleh kosong — frontend memakai path relatif /api yang
# di-proxy ke backend oleh vite.config.js.
VITE_API_BASE_URL=http://localhost:5002/api
