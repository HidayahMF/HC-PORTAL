# ===== WAG BACKEND ENVIRONMENT TEMPLATE =====
# Salin file ini menjadi .env dan isi nilai riil.
# JANGAN pernah memasukkan kredensial asli ke dalam file yang di-commit.

# --- Server ---
PORT=5002
NODE_ENV=development
LOG_LEVEL=info

# --- SQL Server (wajib) ---
DB_SERVER=your_db_host
DB_DATABASE=BMC
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
# Opsional tuning pool:
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT=15000
# DB_REQUEST_TIMEOUT=30000

# --- MySQL (wajib untuk monitoring & SIM) ---
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=pw2

# --- JWT (wajib, minimal 32 karakter) ---
JWT_SECRET=generate_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# --- Whitelist login (wajib) ---
# NIP yang boleh login, comma-separated
ALLOWED_NIPS=3490,0377

# --- Role assignment ---
# 3490 & 0377 = admin. Semua NIP lain yang boleh login = viewer (default terkunci).
# Jika ALLOWED_ADMIN_NIPS dikosongkan, backend memakai default: 3490,0377.
# ALLOWED_VIEWER_NIPS opsional — NIP yang ingin dipaksa viewer (redundan dengan default).
ALLOWED_ADMIN_NIPS=3490,0377
ALLOWED_VIEWER_NIPS=

# --- WhatsApp Gateway ---
WA_API=http://your_wagw_host:3000/api/send
WAGW_API=http://your_wagw_host:3000/api/send
WAGW_FILE_DIR=C:\\path\\to\\wagwfile\\file
# Opsional (Linux/Docker): WAGW_SMB_MOUNT=/mnt/wagw
# WAJIB (development Windows): host SMB share WAGW, tanpa backslash
# WAGW_SMB_HOST=10.x.x.x

# --- CORS (wajib di production) ---
# Comma-separated daftar origin frontend yang diizinkan
CORS_ORIGIN=http://localhost:5173,http://localhost:3002
