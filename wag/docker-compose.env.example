# ===== DOCKER COMPOSE ENVIRONMENT TEMPLATE =====
# Salin file ini menjadi .env (di folder yang sama dengan docker-compose.yml),
# lalu isi nilai riil. JANGAN commit kredensial asli.

# --- Deployment ---
NODE_ENV=production

# --- SQL Server ---
DB_SERVER=your_db_host
DB_DATABASE=BMC
DB_USER=your_db_user
# PENTING: password yang mengandung $ WAJIB ditulis $$ (aturan Compose).
# Contoh: password "silver$boy" ditulis → silver$$boy
DB_PASSWORD=your_db_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# --- MySQL ---
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=pw2

# --- JWT & whitelist ---
JWT_SECRET=generate_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
ALLOWED_NIPS=3490,0377
ALLOWED_ADMIN_NIPS=3490,0377
ALLOWED_VIEWER_NIPS=

# --- WhatsApp Gateway ---
WA_API=http://your_wagw_host:3000/api/send
WAGW_API=http://your_wagw_host:3000/api/send
# Path Windows di VM gateway — tulis backslash SEKALI (jangan \\).
WAGW_FILE_DIR=C:\path\to\wagwfile\file
WAGW_SMB_MOUNT=/mnt/wagw

# --- CORS (origin frontend production) ---
CORS_ORIGIN=http://localhost:3002
